# FUTUREPATH AI - Server Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (SQLite default for turnkey instant local development, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/futurepath_db?schema=public"

# Authentication
JWT_SECRET=futurepath_jwt_super_secret_dev_key_2026_secured

# Payments (Razorpay India)
# In development, the application operates in sandbox mock mode automatically
RAZORPAY_KEY_ID=rzp_test_futurepath_mock_id
RAZORPAY_KEY_SECRET=rzp_test_futurepath_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_here

# AI Service Configuration
# Optional: If unset or invalid, the platform activates the high-quality deterministic Indian career guidance intelligence fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=deterministic_fallback
